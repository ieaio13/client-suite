# On cPanel, enter these in "Setup Node.js App" → Environment variables.
# For running on your own computer, copy this file to .env and fill it in.

# Supabase → Project Settings → Data API / API Keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service_role (or secret) key, NOT the anon/publishable key. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the app, used in client portal links and emails (no trailing slash)
APP_URL=https://app.arjunkarki1.com.np

# Timezone for dates and timestamps
APP_TIMEZONE=Asia/Kathmandu

# One-time code for creating the first Admin. Use 16+ random characters.
# It stops working once a team member exists.
SETUP_CODE=

# Email through a cPanel mailbox (cPanel → Email Accounts → Connect Devices shows these)
SMTP_HOST=mail.arjunkarki1.com.np
SMTP_PORT=465
SMTP_USER=noreply@arjunkarki1.com.np
SMTP_PASS=
MAIL_FROM=Client Suite <noreply@arjunkarki1.com.np>

# Optional: Supabase publishable (anon) key. Enables Supabase Realtime for live
# updates. Without it, live updates still work through the app's own event stream.
SUPABASE_ANON_KEY=
